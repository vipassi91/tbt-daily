# short addresses for the admin pages
/admin /admin-daily 200
/pemain /admin-pemain 200

# a player's own page: one page serves every player, the id is read from the address.
# /players/<id>/<nickname> is the address in use. /player/... is the older one and still works: browsers that opened it while it
# was broken remember a redirect forever, which is why the address in use is a different one.
# The destination must NOT end in .html: Cloudflare Pages answers such a rule with a redirect to the clean address and drops the rest of the path.
# the list of all players is the page players.html (served at /players); a trailing slash goes to it too, before the rule below takes it for a player
/players/ /players 301
/players/* /player 200
/player/* /player 200

# events: the list is events.html (served at /events); one event is /events/<id>/<name>, served by the same page.
# A trailing slash goes to the list first, before the rule below takes it for an event.
/events/ /events 301
/events/* /events 200
# a booking: /b/<private token>, served by the events page
/b/* /events 200
# the admin page for events
/admin-events/ /admin-events 301
